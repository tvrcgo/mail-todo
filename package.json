{
  "name": "mailtodo",
  "productName": "MailTodo",
  "version": "0.1.0",
  "description": "以邮箱为后端的待办应用",
  "main": "dist-electron/electron/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:icon": "node scripts/patch-dev-icon.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "postinstall": "node scripts/patch-dev-icon.mjs || exit 0",
    "dist": "npm run build && electron-builder --win nsis",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "imapflow": "^2.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "build": {
    "appId": "com.mailtodo.app",
    "productName": "MailTodo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
